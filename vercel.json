{
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/service-worker.js",
      "destination": "/service-worker.js"
    },
    {
      "source": "/onesignal/:path*",
      "destination": "/onesignal/:path*"
    },
    {
      "source": "/OneSignalSDK.sw.js",
      "destination": "/OneSignalSDK.sw.js"
    },
    {
      "source": "/OneSignalSDKWorker.js",
      "destination": "/OneSignalSDKWorker.js"
    },
    {
      "source": "/OneSignalSDKUpdaterWorker.js",
      "destination": "/OneSignalSDKUpdaterWorker.js"
    },
    {
      "source": "/integrations/fyll-checkout/:path*",
      "destination": "/api/integrations/fyll-checkout/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "track.fyll.app"
        }
      ],
      "destination": "/order-tracking",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "returns.fyll.app"
        }
      ],
      "destination": "/start-return",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "confirm.fyll.app"
        }
      ],
      "destination": "/confirm-delivery",
      "permanent": false
    }
  ]
}
